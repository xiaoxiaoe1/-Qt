/* =========================
   学生管理系统 - 工业后台风格
   设计关键词：稳重、清晰、控制台感
   ========================= */

QWidget {
    background-color: #131a22;
    color: #d8e1ea;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 14px;
}

QMainWindow {
    background-color: #0f151d;
}

#leftNav {
    background-color: #19232d;
    border-right: 1px solid #2f3d4b;
}

#contentPanel {
    background-color: #101720;
    border: 1px solid #263340;
    border-radius: 18px;
}

QToolButton {
    background-color: #22303d;
    color: #d8e1ea;
    border: 1px solid #334556;
    border-radius: 14px;
    min-width: 94px;
    min-height: 94px;
    padding: 10px 6px;
    margin: 8px 6px;
    font-size: 13px;
    font-weight: 600;
    icon-size: 44px;
}

QToolButton:hover {
    background-color: #2a3b4a;
    border: 1px solid #4c667b;
}

QToolButton:checked {
    background-color: #335066;
    border: 1px solid #77a7c8;
    color: #ffffff;
}

QPushButton {
    background-color: #2f4e63;
    color: #eef5fb;
    border: 1px solid #49677e;
    border-radius: 10px;
    padding: 10px 18px;
    min-height: 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3a617a;
    border: 1px solid #6d8da5;
}

QPushButton:pressed {
    background-color: #284254;
}

QPushButton:disabled {
    background-color: #263340;
    color: #7c8a98;
    border-color: #2d3b49;
}

QLineEdit,
QComboBox,
QSpinBox,
QDateEdit,
QTimeEdit,
QPlainTextEdit,
QTextEdit {
    background-color: #1a242e;
    color: #e4edf6;
    border: 1px solid #344553;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #49708b;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1px solid #7aa6c2;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView,
QDateEdit QAbstractItemView {
    background-color: #1b2530;
    color: #dbe5ee;
    border: 1px solid #344553;
    selection-background-color: #335066;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: #2c3f4e;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #3b5569;
}

QLabel {
    background: transparent;
    color: #d3dde7;
}

QGroupBox {
    border: 1px solid #2f3e4d;
    border-radius: 12px;
    margin-top: 14px;
    padding-top: 14px;
    background-color: #161f28;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #9fb5c7;
}

QTableWidget,
QTableView,
QTreeView,
QListView {
    background-color: #131c25;
    alternate-background-color: #18232d;
    border: 1px solid #2d3c4a;
    border-radius: 12px;
    gridline-color: #24313d;
    selection-background-color: #335066;
    selection-color: #ffffff;
}

QTableWidget::item,
QTableView::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #233240;
    color: #dfe9f2;
    border: none;
    border-right: 1px solid #314150;
    border-bottom: 1px solid #314150;
    padding: 8px 6px;
    font-weight: 700;
}

QScrollBar:vertical {
    background: #141d26;
    width: 12px;
    margin: 12px 0 12px 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #3d5568;
    min-height: 28px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #53728a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

QDialog {
    background-color: #151d26;
}

QMessageBox {
    background-color: #151d26;
}

QStatusBar,
QMenuBar {
    background-color: #18222c;
    color: #d6e0ea;
}
