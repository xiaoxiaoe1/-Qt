/* ======================================
   终极发光 · 赛博朋克 炸裂游戏UI
====================================== */
QMainWindow {
    background-color: #050218;
}

/* 左侧面板 */
#leftWidget {
    background-color: #100a22;
    border-right: 4px solid #ff00ff;
}

/* 工具按钮 - 基础 */
QToolButton {
    background-color: #1b143a;
    border: 2px solid #a0f;
    border-radius: 14px;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    min-width: 90px;
    min-height: 90px;
    icon-size: 48px;
    margin: 8px;
}

/* 悬停 - 青色超强发光 */
QToolButton:hover {
    background-color: #241852;
    border: 2px solid #0ff;
    color: #0ff;

}

/* 选中 - 终极紫色爆炸发光 */
QToolButton:checked {
    background-color: #32206a;
    border: 2px solid #ff00ff;
    color: #fff;

}

/* 右侧内容卡片 */
QStackedWidget {
    background-color: #0d0824;
    border-radius: 22px;
    border: 0px solid #a0f;
    margin: none;
}

/* 全局透明 */
QWidget {
    background-color: transparent;
}

/* 文字 */
QLabel {
    color: #e0d8ff;
    font-size: 15px;
}

/* 输入框 */
QLineEdit {
    background-color: #1b143a;
    border: 2px solid #a0f;
    border-radius: 10px;
    padding: 10px;
    color: #fff;
}
QLineEdit:focus {
    border: 2px solid #0ff;

}

/* 按钮 */
QPushButton {
    background-color: #ff00aa;
    border-radius: 12px;
    color: white;
    padding: 12px 24px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #ff29aa;

}

/* ============================== */
/* ✅ 性别下拉框 QComboBox 浅色样式 */
/* ============================== */
QComboBox {
    background-color: #f0f8ff;    /* 浅色背景 */
    color: #1f2937;               /* 深色文字，看得非常清楚 */
    border: 2px solid #a0f;
    border-radius: 10px;
    padding: 10px;
    font-size: 14px;
    min-height: 20px;
}

/* 下拉列表本身（点击展开的部分） */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #a0f; /* 选中紫色发光 */
    selection-color: #ffffff;
    border: 1px solid #a0f;
}

/* 下拉箭头 */
QComboBox::drop-down {
    border: none;
    width: 30px;
}
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    border-image: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAQElEQVQYlWNgYGD4z8DAwMgABXAGNgGwSgwVAFbmAgXQdISfAAAAABJRU5ErkJggg==);
}

/* 聚焦时青色发光 */
QComboBox:focus {
    border: 2px solid #0ff;
}

/* ============================== */
/* ✅ 年龄输入框 QSpinBox 浅色样式 */
/* ============================== */
QSpinBox {
    background-color: #f0f8ff;    /* 浅白背景，和性别下拉框一致 */
    color: #1f2937;               /* 深色文字，清晰可见 */
    border: 2px solid #a0f;
    border-radius: 10px;
    padding: 10px;
    font-size: 14px;
    min-height: 20px;
}

/* 上下调节按钮区域 */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #a0f;
    border: none;
    width: 25px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #0ff;
}

/* 上下箭头图标 */
QSpinBox::up-arrow {
    width: 8px;
    height: 8px;
    border-image: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAkAAAAJCAYAAADkuczmAAAAQElEQVQYlWNgYGD4z8DAwMgABXAGNgGwSgwVAFbmAgXQdISfAAAAABJRU5ErkJggg==);
}
QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
    border-image: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAkAAAAJCAYAAADkuczmAAAAQ0lEQVQYlWNgYGD4z8DAwMgABXAGNgGwSgwVAFbmAgXQdISfAAAAABJRU5ErkJggg==);
}

/* 聚焦时青色发光（和输入框一致） */
QSpinBox:focus {
    border: 2px solid #0ff;
}
